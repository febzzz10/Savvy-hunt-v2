# Browser-safe configuration
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login

# Local / Vercel server-only configuration
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
GOOGLE_DRIVE_FOLDER_ID=
# Optional: separate incoming folder. If empty, use GOOGLE_DRIVE_FOLDER_ID for both.
GOOGLE_DRIVE_INCOMING_FOLDER_ID=
# Read-only service account. Share the folder directly with this email as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GALLERY_PROXY_SECRET=

# Convex development deployment environment (set with Convex CLI/dashboard)
# CLERK_JWT_ISSUER_DOMAIN= (issuer domain, never the /.well-known/jwks.json URL)
# First admin: owner-only internal CLI bootstrap; see docs/admin-setup.md.
# No bootstrap secret or privileged browser endpoint is used.
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_INCOMING_FOLDER_ID= (optional)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GALLERY_PROXY_SECRET= (same secret as local/Vercel server)
