# Browser-safe configuration
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login

# Local / Vercel server-only configuration
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GALLERY_PROXY_SECRET=

# Convex development deployment environment (set with Convex CLI/dashboard)
# CLERK_JWT_ISSUER_DOMAIN= (issuer domain, never the /.well-known/jwks.json URL)
# ADMIN_BOOTSTRAP_SECRET= (temporary, remove after first admin setup)
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GALLERY_PROXY_SECRET= (same secret as local/Vercel server)
